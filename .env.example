# ReviewQuest environment variables
# Copy this file to `.env.local` and fill in your own keys:
#   cp .env.example .env.local
# NEVER commit `.env.local` or real keys.

# ---------------------------------------------------------------
# AI providers (server-side only, no NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------
# You need at least ONE of these. Requests try Gemini first, then
# Groq, then OpenRouter, so adding more gives you automatic failover.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------
# Optional model overrides (defaults shown)
# ---------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# AI_MODEL=google/gemini-2.5-flash-lite   # used for the OpenRouter fallback

# ---------------------------------------------------------------
# Supabase (OPTIONAL: cloud sync is a work in progress)
# ---------------------------------------------------------------
# The app runs fine without these. They are only needed once cloud
# sync is wired up. The anon key is public by design, so protect your
# data with Row Level Security, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
