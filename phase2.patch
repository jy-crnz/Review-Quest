@@ -0,0 +1,29 @@
+/**
+ * Central limits for the API routes. Keep them in one place so the client,
+ * the routes, and the docs can't drift apart.
+ */
+
+/** Max PDF upload size. Mirrored in FileUpload.tsx. */
+export const MAX_UPLOAD_BYTES = 20 * 1024 * 1024;
+
+/** Extra room for multipart boundaries/headers on top of the file itself. */
+export const MULTIPART_OVERHEAD_BYTES = 256 * 1024;
+
+/** Max PDF pages we will read. Extra pages are ignored (response is flagged `truncated`). */
+export const MAX_PDF_PAGES = 500;
+
+/** Soft time budget for PDF text extraction. Extra pages are ignored once exceeded. */
+export const EXTRACT_TIME_BUDGET_MS = 20_000;
+
+/**
+ * Max characters of study text we accept or return.
+ * NOTE: the syllabus prompt currently only reads the first 80,000 characters,
+ * so this is intentionally generous.
+ */
+export const MAX_STUDY_TEXT_CHARS = 300_000;
+
+/** Max JSON body size for routes that receive study text (UTF-8 can be up to 4 bytes/char). */
+export const MAX_TEXT_BODY_BYTES = 1_500_000;
+
+/** Max JSON body size for routes that receive a single stage (small objects). */
+export const MAX_STAGE_BODY_BYTES = 100_000;
diff --git a/src/lib/api/rateLimit.ts b/src/lib/api/rateLimit.ts
new file mode 100644
index 0000000..86009dc
--- /dev/null
+++ b/src/lib/api/rateLimit.ts
@@ -0,0 +1,68 @@
+/**
+ * Fixed-window, in-memory rate limiter keyed by route + client IP.
+ *
+ * LIMITATIONS (be aware before relying on it in production):
+ * - State lives in this server process. On serverless platforms each instance
+ *   keeps its own counters, so the real limit is "per instance". It still stops
+ *   casual abuse; for strict limits use a shared store (e.g. Upstash Redis).
+ * - The client IP comes from `x-forwarded-for`. That is only trustworthy behind a
+ *   proxy/platform that sets or overwrites it (e.g. Vercel). Behind anything
+ *   else, clients can spoof it.
+ * - Students sharing one network (a school) share one IP, so raise
+ *   RATE_LIMIT_PER_MINUTE if legitimate users get blocked.
+ */
+
+const WINDOW_MS = 60_000;
+const DEFAULT_LIMIT_PER_MINUTE = 30;
+const SWEEP_THRESHOLD = 5_000;
+
+interface Bucket {
+    count: number;
+    resetAt: number;
+}
+
+// Stored on globalThis so dev-server hot reloads don't reset the counters.
+const globalStore = globalThis as unknown as { __rqRateBuckets?: Map<string, Bucket> };
+const buckets: Map<string, Bucket> = (globalStore.__rqRateBuckets ??= new Map());
+
+function limitPerMinute(): number {
+    const parsed = Number.parseInt(process.env.RATE_LIMIT_PER_MINUTE ?? '', 10);
+    return Number.isFinite(parsed) && parsed > 0 ? parsed : DEFAULT_LIMIT_PER_MINUTE;
+}
+
+export function getClientIp(req: Request): string {
+    const forwarded = req.headers.get('x-forwarded-for');
+    if (forwarded) {
+        const first = forwarded.split(',')[0]?.trim();
+        if (first) return first;
+    }
+    return req.headers.get('x-real-ip')?.trim() || 'unknown';
+}
+
+function sweepExpired(now: number): void {
+    for (const [key, bucket] of buckets) {
+        if (bucket.resetAt <= now) buckets.delete(key);
+    }
+}
+
+export type RateLimitResult = { ok: true } | { ok: false; retryAfterSeconds: number };
+
+export function checkRateLimit(req: Request, routeKey: string): RateLimitResult {
+    const now = Date.now();
+    if (buckets.size > SWEEP_THRESHOLD) sweepExpired(now);
+
+    const key = `${routeKey}:${getClientIp(req)}`;
+    const bucket = buckets.get(key);
+
+    if (!bucket || bucket.resetAt <= now) {
+        buckets.set(key, { count: 1, resetAt: now + WINDOW_MS });
+        return { ok: true };
+    }
+
+    if (bucket.count >= limitPerMinute()) {
+        return { ok: false, retryAfterSeconds: Math.max(1, Math.ceil((bucket.resetAt - now) / 1000)) };
+    }
+
+    bucket.count += 1;
+    return { ok: true };
+}
diff --git a/src/lib/api/schemas.ts b/src/lib/api/schemas.ts
new file mode 100644
index 0000000..81386b0
--- /dev/null
+++ b/src/lib/api/schemas.ts
@@ -0,0 +1,37 @@
+import { z } from 'zod';
+import { MAX_STUDY_TEXT_CHARS } from './limits';
+
+/** Request-body schemas for the API routes. Bounded so clients can't send huge or malformed payloads. */
+
+export const QuizTypeSchema = z.enum(['multiple-choice', 'true-false', 'enumeration']);
+
+const studyText = z
+    .string()
+    .max(MAX_STUDY_TEXT_CHARS)
+    .refine((text) => text.trim().length >= 30, 'Insufficient study text.');
+
+export const SyllabusRequestSchema = z.object({
+    text: studyText,
+});
+
+export const GenerateRequestSchema = z.object({
+    text: studyText,
+    quizType: QuizTypeSchema,
+});
+
+const StageItemRequestSchema = z.object({
+    term: z.string().max(500),
+    description: z.string().max(2000),
+});
+
+export const GenerateStageRequestSchema = z.object({
+    stage: z.object({
+        stageIndex: z.number(),
+        title: z.string().max(300),
+        enemyId: z.string().max(64).default('vanguard_scout'),
+        summary: z.string().max(1000).optional(),
+        items: z.array(StageItemRequestSchema).min(1).max(50),
+    }),
+    // Matches previous behavior: missing quizType falls back to multiple-choice.
+    quizType: QuizTypeSchema.default('multiple-choice'),
+});
